+* gracefully when the active model cannot see images: the conversation keeps
+* its text, and only the provider request loses the pictures.
+* @param messages - the original (possibly deep-frozen) message list.
+* @returns a detached message list without image blocks.
+*/
+function stripImageBlocks(messages) {
+	const stripBlocks = (blocks) => {
+		let changed = false;
+		const out = [];
+		for (const block of blocks) {
+			if (block.type === "image") {
+				changed = true;
+				continue;
+			}
+			if (block.type === "tool-result") {
+				const content = stripBlocks(block.content);
+				if (content !== block.content) {
